{
  "title": "Tech Challenge — Saga (demo)",
  "description": "Dashboard da janela de demo (Saga): latência/erros/hits APM nos 5 serviços, transições de OS (logs), compensações, nacks Pub/Sub, DLQ e Cloud SQL (integração GCP).",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Latência p95 APM por serviço",
        "type": "timeseries",
        "requests": [
          {
            "q": "p95:trace.aspnet_core.request{service:ordem-servico-service,env:prod}",
            "display_type": "line"
          },
          {
            "q": "p95:trace.aspnet_core.request{service:estoque-service,env:prod}",
            "display_type": "line"
          },
          {
            "q": "p95:trace.aspnet_core.request{service:orcamento-service,env:prod}",
            "display_type": "line"
          },
          {
            "q": "p95:trace.aspnet_core.request{service:administrativo-service,env:prod}",
            "display_type": "line"
          },
          {
            "q": "p95:trace.aspnet_core.request{service:autenticacao-service,env:prod}",
            "display_type": "line"
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Erros HTTP APM por serviço",
        "type": "timeseries",
        "requests": [
          {
            "q": "sum:trace.aspnet_core.request.errors{service:ordem-servico-service,env:prod}.as_count()",
            "display_type": "bars"
