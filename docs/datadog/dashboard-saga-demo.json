            }
          },
          {
            "definition": {
              "title": "API request latency avg",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.firestore.api.request_latencies.avg{project_id:vcosta-fiap-tech-challenge AND (database_id:autenticacao OR database_id:orcamento)} by {database_id,api_method}",
                  "display_type": "line"
                }
