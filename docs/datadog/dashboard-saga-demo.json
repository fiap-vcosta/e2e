                  "q": "avg:gcp.cloudsql.database.cpu.utilization{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Memory utilization",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.cloudsql.database.memory.utilization{project_id:vcosta-fiap-tech-challenge,database_id:vcosta-fiap-tech-challenge:tech-challenge-pg}",
