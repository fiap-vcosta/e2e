        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "API request count",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.firestore.api.request_count{project_id:vcosta-fiap-tech-challenge AND (database_id:autenticacao OR database_id:orcamento)} by {database_id,api_method}.as_count()",
                  "display_type": "bars"
                }
