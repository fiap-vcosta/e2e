{
  "title": "[saga] dashboard",
  "description": "Dashboard geral da Saga: monitores, golden metrics das APIs, Pub/Sub entrada/saída/DLQ, Cloud SQL, Firestore e transições de OS.",
  "layout_type": "ordered",
  "reflow_type": "auto",
  "widgets": [
    {
      "definition": {
        "title": "Monitores",
        "background_color": "purple",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "type": "manage_status",
              "query": "name:([ordem-servico]* OR [estoque]* OR [orcamento]* OR [administrativo]* OR [autenticacao]* OR [saga]*)",
              "display_format": "counts",
              "color_preference": "background",
              "hide_zero_counts": false,
              "show_last_triggered": true,
              "show_priority": true,
              "show_status": true,
              "sort": "status,asc",
              "count": 50,
              "start": 0,
              "summary_type": "monitors",
              "title": "Monitores [servico] / [saga]",
              "title_size": "16",
              "title_align": "left"
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "APIs (golden metrics)",
        "background_color": "vivid_blue",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Latência p95 por serviço",
              "type": "timeseries",
              "requests": [
                {
                  "q": "p95:trace.aspnet_core.request{service:ordem-servico-service,env:prod}",
                  "display_type": "line"
                },
                {
                  "q": "p95:trace.aspnet_core.request{service:estoque-service,env:prod}",
                  "display_type": "line"
                },
                {
                  "q": "p95:trace.aspnet_core.request{service:orcamento-service,env:prod}",
                  "display_type": "line"
                },
                {
                  "q": "p95:trace.aspnet_core.request{service:administrativo-service,env:prod}",
                  "display_type": "line"
                },
                {
                  "q": "p95:trace.aspnet_core.request{service:autenticacao-service,env:prod}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Tráfego — hits por serviço",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:ordem-servico-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:estoque-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:orcamento-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:administrativo-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.hits{service:autenticacao-service,env:prod}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Erros por serviço",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:ordem-servico-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:estoque-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:orcamento-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:administrativo-service,env:prod}.as_count()",
                  "display_type": "bars"
                },
                {
                  "q": "sum:trace.aspnet_core.request.errors{service:autenticacao-service,env:prod}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Taxa de erro por serviço",
              "type": "timeseries",
              "requests": [
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:ordem-servico-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:ordem-servico-service,env:prod}.as_count())",
                  "display_type": "line"
                },
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:estoque-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:estoque-service,env:prod}.as_count())",
                  "display_type": "line"
                },
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:orcamento-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:orcamento-service,env:prod}.as_count())",
                  "display_type": "line"
                },
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:administrativo-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:administrativo-service,env:prod}.as_count())",
                  "display_type": "line"
                },
                {
                  "q": "(sum:trace.aspnet_core.request.errors{service:autenticacao-service,env:prod}.as_count() / sum:trace.aspnet_core.request.hits{service:autenticacao-service,env:prod}.as_count())",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Eventos de entrada (todas subscriptions)",
        "background_color": "orange",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Undelivered por subscription",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.subscription.num_undelivered_messages{project_id:vcosta-fiap-tech-challenge AND (subscription_id:estoque-ordem-servico-aprovada OR subscription_id:estoque-ordem-servico-descartada OR subscription_id:estoque-ordem-servico-finalizada OR subscription_id:orcamento-diagnostico-finalizado OR subscription_id:orcamento-ordem-servico-descartada OR subscription_id:orcamento-ordem-servico-finalizada OR subscription_id:ordem-servico-cobranca-gerada OR subscription_id:ordem-servico-estoque-em-falta OR subscription_id:ordem-servico-estoque-reservado OR subscription_id:ordem-servico-orcamento-falhou OR subscription_id:ordem-servico-orcamento-gerado OR subscription_id:ordem-servico-pagamento-confirmado OR subscription_id:ordem-servico-pagamento-recusado)} by {subscription_id}",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Ack message count",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.subscription.ack_message_count{project_id:vcosta-fiap-tech-challenge AND (subscription_id:estoque-ordem-servico-aprovada OR subscription_id:estoque-ordem-servico-descartada OR subscription_id:estoque-ordem-servico-finalizada OR subscription_id:orcamento-diagnostico-finalizado OR subscription_id:orcamento-ordem-servico-descartada OR subscription_id:orcamento-ordem-servico-finalizada OR subscription_id:ordem-servico-cobranca-gerada OR subscription_id:ordem-servico-estoque-em-falta OR subscription_id:ordem-servico-estoque-reservado OR subscription_id:ordem-servico-orcamento-falhou OR subscription_id:ordem-servico-orcamento-gerado OR subscription_id:ordem-servico-pagamento-confirmado OR subscription_id:ordem-servico-pagamento-recusado)} by {subscription_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Oldest unacked age (s)",
              "type": "timeseries",
              "requests": [
                {
                  "q": "max:gcp.pubsub.subscription.oldest_unacked_message_age{project_id:vcosta-fiap-tech-challenge AND (subscription_id:estoque-ordem-servico-aprovada OR subscription_id:estoque-ordem-servico-descartada OR subscription_id:estoque-ordem-servico-finalizada OR subscription_id:orcamento-diagnostico-finalizado OR subscription_id:orcamento-ordem-servico-descartada OR subscription_id:orcamento-ordem-servico-finalizada OR subscription_id:ordem-servico-cobranca-gerada OR subscription_id:ordem-servico-estoque-em-falta OR subscription_id:ordem-servico-estoque-reservado OR subscription_id:ordem-servico-orcamento-falhou OR subscription_id:ordem-servico-orcamento-gerado OR subscription_id:ordem-servico-pagamento-confirmado OR subscription_id:ordem-servico-pagamento-recusado)} by {subscription_id}",
                  "display_type": "line"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Nack requests",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.subscription.nack_requests{project_id:vcosta-fiap-tech-challenge AND (subscription_id:estoque-ordem-servico-aprovada OR subscription_id:estoque-ordem-servico-descartada OR subscription_id:estoque-ordem-servico-finalizada OR subscription_id:orcamento-diagnostico-finalizado OR subscription_id:orcamento-ordem-servico-descartada OR subscription_id:orcamento-ordem-servico-finalizada OR subscription_id:ordem-servico-cobranca-gerada OR subscription_id:ordem-servico-estoque-em-falta OR subscription_id:ordem-servico-estoque-reservado OR subscription_id:ordem-servico-orcamento-falhou OR subscription_id:ordem-servico-orcamento-gerado OR subscription_id:ordem-servico-pagamento-confirmado OR subscription_id:ordem-servico-pagamento-recusado)} by {subscription_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Eventos de saída (tópicos publicados)",
        "background_color": "green",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "Publish send_request_count",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.topic.send_request_count{project_id:vcosta-fiap-tech-challenge AND (topic_id:cobranca-gerada OR topic_id:diagnostico-finalizado OR topic_id:estoque-em-falta OR topic_id:estoque-reservado OR topic_id:notificacoes OR topic_id:orcamento-falhou OR topic_id:orcamento-gerado OR topic_id:ordem-servico-aprovada OR topic_id:ordem-servico-descartada OR topic_id:ordem-servico-finalizada OR topic_id:pagamento-confirmado OR topic_id:pagamento-recusado)} by {topic_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Mensagens retidas no tópico",
              "type": "timeseries",
              "requests": [
                {
                  "q": "avg:gcp.pubsub.topic.num_retained_messages{project_id:vcosta-fiap-tech-challenge AND (topic_id:cobranca-gerada OR topic_id:diagnostico-finalizado OR topic_id:estoque-em-falta OR topic_id:estoque-reservado OR topic_id:notificacoes OR topic_id:orcamento-falhou OR topic_id:orcamento-gerado OR topic_id:ordem-servico-aprovada OR topic_id:ordem-servico-descartada OR topic_id:ordem-servico-finalizada OR topic_id:pagamento-confirmado OR topic_id:pagamento-recusado)} by {topic_id}",
                  "display_type": "line"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
        "title": "Dead-letter (DLQ)",
        "background_color": "pink",
        "show_title": true,
        "type": "group",
        "layout_type": "ordered",
        "widgets": [
          {
            "definition": {
              "title": "dead_letter_message_count",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.subscription.dead_letter_message_count{project_id:vcosta-fiap-tech-challenge AND (subscription_id:estoque-ordem-servico-aprovada OR subscription_id:estoque-ordem-servico-descartada OR subscription_id:estoque-ordem-servico-finalizada OR subscription_id:orcamento-diagnostico-finalizado OR subscription_id:orcamento-ordem-servico-descartada OR subscription_id:orcamento-ordem-servico-finalizada OR subscription_id:ordem-servico-cobranca-gerada OR subscription_id:ordem-servico-estoque-em-falta OR subscription_id:ordem-servico-estoque-reservado OR subscription_id:ordem-servico-orcamento-falhou OR subscription_id:ordem-servico-orcamento-gerado OR subscription_id:ordem-servico-pagamento-confirmado OR subscription_id:ordem-servico-pagamento-recusado)} by {subscription_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          },
          {
            "definition": {
              "title": "Envios aos tópicos *-dlq",
              "type": "timeseries",
              "requests": [
                {
                  "q": "sum:gcp.pubsub.topic.send_request_count{project_id:vcosta-fiap-tech-challenge AND (topic_id:estoque-ordem-servico-aprovada-dlq OR topic_id:estoque-ordem-servico-descartada-dlq OR topic_id:estoque-ordem-servico-finalizada-dlq OR topic_id:orcamento-diagnostico-finalizado-dlq OR topic_id:orcamento-ordem-servico-descartada-dlq OR topic_id:orcamento-ordem-servico-finalizada-dlq OR topic_id:ordem-servico-cobranca-gerada-dlq OR topic_id:ordem-servico-estoque-em-falta-dlq OR topic_id:ordem-servico-estoque-reservado-dlq OR topic_id:ordem-servico-orcamento-falhou-dlq OR topic_id:ordem-servico-orcamento-gerado-dlq OR topic_id:ordem-servico-pagamento-confirmado-dlq OR topic_id:ordem-servico-pagamento-recusado-dlq)} by {topic_id}.as_count()",
                  "display_type": "bars"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "definition": {
