{
  "priority": 1,
  "request": {
    "method": "GET",
    "urlPathPattern": "/v1/orders/ORD_REFUSED.*"
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "transformers": ["response-template"],
    "jsonBody": {
      "id": "{{request.pathSegments.[2]}}",
      "status": "rejected",
      "status_detail": "rejected_by_bank",
      "transactions": {
        "payments": [
          {
            "amount": "100.00",
            "payment_method": {
              "id": "pix",
              "type": "bank_transfer",
              "qr_code": "00020126e2e-fake-pix-qr",
              "ticket_url": "https://www.mercadopago.com.br/payments/e2e/ticket"
            }
          }
        ]
      }
    }
  }
}
